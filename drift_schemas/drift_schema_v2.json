      ]
    },
    {
      "name": "income_sources",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"income_sources\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"amount_minor\" INTEGER NOT NULL, \"currency_code\" TEXT NOT NULL, \"schedule_json\" TEXT NOT NULL, \"start_date\" TEXT NOT NULL, \"end_date\" TEXT NULL, \"frozen_through\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"archived_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "income_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"income_entries\" (\"id\" TEXT NOT NULL, \"source_id\" TEXT NOT NULL REFERENCES income_sources (id), \"original_date\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"amount_minor\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"source_id\", \"original_date\"));"
        }
      ]
    },
