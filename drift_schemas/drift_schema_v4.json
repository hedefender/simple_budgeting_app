      "name": "expenses",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"expenses\" (\"id\" TEXT NOT NULL, \"description\" TEXT NULL, \"category_id\" TEXT NOT NULL REFERENCES categories (id), \"expense_date\" TEXT NOT NULL, \"currency_code\" TEXT NOT NULL, \"amount_minor\" INTEGER NULL, \"original_amount_minor\" INTEGER NULL, \"original_currency_code\" TEXT NULL, \"tax_amount_minor\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (amount_minor IS NOT NULL OR (original_amount_minor IS NOT NULL AND original_currency_code IS NOT NULL)), CHECK ((original_amount_minor IS NULL) = (original_currency_code IS NULL)), CHECK (amount_minor IS NULL OR amount_minor > 0), CHECK (original_amount_minor IS NULL OR original_amount_minor > 0), CHECK (tax_amount_minor IS NULL OR tax_amount_minor > 0));"
