          "sql": "CREATE TABLE IF NOT EXISTS \"balance_anchors\" (\"id\" TEXT NOT NULL, \"anchor_date\" TEXT NOT NULL, \"balance_minor\" INTEGER NOT NULL, \"currency_code\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"anchor_date\", \"currency_code\"));"
        }
      ]
    },
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" TEXT NOT NULL, \"category_key\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"category_key\"));"
        }
      ]
    },
